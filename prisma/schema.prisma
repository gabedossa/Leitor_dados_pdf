// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft delete

  // relations
  companies          Company[]
  projects           Project[]
  pdfs               PdfDocument[]
  dataRecords        DataRecord[]
  charts             Chart[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[]

  @@map("companies")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  // UI color for sidebar identification
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  pdfs        PdfDocument[]
  dataRecords DataRecord[]
  charts      Chart[]

  @@map("projects")
}

// ─────────────────────────────────────────────
// PDF DOCUMENTS
// ─────────────────────────────────────────────

enum PdfStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model PdfDocument {
  id           String    @id @default(cuid())
  originalName String
  storagePath  String    // path or URL in storage (local or S3)
  fileSize     Int       // bytes
  status       PdfStatus @default(PENDING)
  errorMessage String?   // populated when status = FAILED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  dataRecords DataRecord[]

  @@map("pdf_documents")
}

// ─────────────────────────────────────────────
// DATA MODEL
// ─────────────────────────────────────────────

enum DataSource {
  PDF
  MANUAL
}

// A DataRecord is a named dataset — it can originate from a PDF page/section
// or be manually created. It groups DataColumns (series) and DataPoints (rows).
model DataRecord {
  id          String     @id @default(cuid())
  title       String
  description String?
  source      DataSource
  recordDate  DateTime?  // the date the data refers to (for day/month/year grouping)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pdfDocumentId String?
  pdfDocument  PdfDocument? @relation(fields: [pdfDocumentId], references: [id], onDelete: SetNull)

  columns DataColumn[]
  points  DataPoint[]
  charts  Chart[]

  @@map("data_records")
}

// A DataColumn represents one series/dimension in the dataset (e.g., "Revenue", "Expenses").
model DataColumn {
  id           String  @id @default(cuid())
  name         String
  color        String? // default chart color for this series
  displayOrder Int     @default(0)

  dataRecordId String
  dataRecord   DataRecord @relation(fields: [dataRecordId], references: [id], onDelete: Cascade)

  values DataValue[]

  @@map("data_columns")
}

// A DataPoint represents one row/category on the X-axis (e.g., "Jan", "2024-01", "Product A").
model DataPoint {
  id           String  @id @default(cuid())
  label        String  // x-axis label
  displayOrder Int     @default(0)

  dataRecordId String
  dataRecord   DataRecord @relation(fields: [dataRecordId], references: [id], onDelete: Cascade)

  values DataValue[]

  @@map("data_points")
}

// DataValue is the intersection of a DataPoint (row) and a DataColumn (series).
model DataValue {
  id    String @id @default(cuid())
  value Float

  dataPointId  String
  dataPoint    DataPoint  @relation(fields: [dataPointId], references: [id], onDelete: Cascade)
  dataColumnId String
  dataColumn   DataColumn @relation(fields: [dataColumnId], references: [id], onDelete: Cascade)

  @@unique([dataPointId, dataColumnId])
  @@map("data_values")
}

// ─────────────────────────────────────────────
// CHARTS
// ─────────────────────────────────────────────

enum ChartType {
  LINE
  BAR
  PIE
}

model Chart {
  id        String    @id @default(cuid())
  title     String
  type      ChartType
  config    Json?     // extra Recharts config (axis labels, stacked, legend position, etc.)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dataRecordId String
  dataRecord   DataRecord @relation(fields: [dataRecordId], references: [id], onDelete: Cascade)

  @@map("charts")
}
